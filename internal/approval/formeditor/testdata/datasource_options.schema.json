{
  "version": 2,
  "dataSources": [
    { "id": "DS1", "kind": "static", "name": "cities", "options": [{ "label": "北京", "value": "bj" }] },
    {
      "id": "DS2", "kind": "remote", "name": "remote",
      "request": { "resource": "city", "action": "list" },
      "mapping": { "labelKey": "name", "valueKey": "code" }
    }
  ],
  "presentations": {
    "pc": {
      "children": [
        { "id": "F1", "type": "select", "key": "inline", "label": "内联", "dataSource": { "kind": "static", "options": [{ "label": "上海", "value": "sh" }] } },
        { "id": "F2", "type": "select", "key": "refStatic", "label": "引用静态", "dataSource": { "kind": "ref", "dataSourceId": "DS1" } },
        {
          "id": "F3", "type": "select", "key": "remoteInline", "label": "内联远程",
          "dataSource": {
            "kind": "remote",
            "request": {
              "resource": "city", "action": "list", "version": "v1",
              "params": { "level": { "kind": "literal", "value": 2 }, "enabled": { "kind": "literal", "value": true } }
            },
            "mapping": { "labelKey": "name", "valueKey": "code", "disabledKey": "frozen", "descriptionKey": "remark" }
          }
        },
        { "id": "F4", "type": "select", "key": "refRemote", "label": "引用远程", "dataSource": { "kind": "ref", "dataSourceId": "DS2" } },
        { "id": "F5", "type": "select", "key": "dangling", "label": "悬空引用", "dataSource": { "kind": "ref", "dataSourceId": "missing" } },
        { "id": "F6", "type": "select", "key": "noSource", "label": "无来源" },
        { "id": "F7", "type": "select", "key": "remoteNoRequest", "label": "远程缺请求", "dataSource": { "kind": "remote" } },
        {
          "id": "F8", "type": "select", "key": "boundRemote", "label": "级联远程",
          "dataSource": {
            "kind": "remote",
            "request": {
              "resource": "ward", "action": "list",
              "params": { "deptId": { "kind": "expression", "source": "formData.dept" }, "active": { "kind": "literal", "value": true } }
            }
          }
        }
      ]
    }
  }
}
