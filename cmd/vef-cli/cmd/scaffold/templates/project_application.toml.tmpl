[vef.app]
name = "{{ .Name }}"
port = 8080

# Protected API bodies are opt-in. The key is standard base64 containing an
# AES key (16, 24, or 32 bytes) or an SM4 key (16 bytes).
[vef.api.body_encoding]
enabled = false
# encoding = "aes-gcm+base64"
# key = ""

# The primary data source is mandatory. vef-cli new resource inspects it to
# derive models, so point it at a real database before generating.
[vef.data_sources.primary]
type = "postgres"
host = "127.0.0.1"
port = 5432
user = "postgres"
password = ""
database = "{{ .Name }}"
schema = "public"

[vef.security]
token_expires = "2h"

[vef.cors]
enabled = true
allow_origins = ["*"]

# Redis is opt-in. Leaving it disabled keeps the module in the boot sequence at
# zero cost; enable it before using distributed locks, cross-node push relay or
# the redis_stream event transport.
[vef.redis]
enabled = false
